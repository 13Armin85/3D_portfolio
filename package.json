{
  "name": "3dportfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "test:timer": "node --test tests/timer-compat.test.mjs",
    "test:contact": "node --experimental-strip-types --test tests/contact-route.test.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "assets:build": "node scripts/generate-room-assets.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write app components content lib store scripts tests playwright.config.ts next.config.ts",
    "format:check": "prettier --check app components content lib store scripts tests playwright.config.ts next.config.ts"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.7",
    "patch-package": "^8.0.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-pdf": "^11.0.0",
    "resend": "^6.31.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
