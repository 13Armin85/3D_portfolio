# Set this to your real public origin when deploying outside Vercel.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form: copy this file to .env.local and set these server-only values.
# Create an API key with sending access at https://resend.com/api-keys
RESEND_API_KEY=re_replace_with_your_api_key
# Use an address on a domain you have verified at https://resend.com/domains
RESEND_FROM_EMAIL="Armin Portfolio <contact@your-verified-domain.com>"
# Inbox that receives contact submissions (never supplied by the visitor).
CONTACT_TO_EMAIL=natajarmin@gmail.com
# Resend's onboarding@resend.dev sender is for testing with your Resend account's
# own email as CONTACT_TO_EMAIL. Use a verified domain for production.
